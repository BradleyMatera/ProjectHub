      "label": "Cloudflare Workers AI — Llama 3.2 3B Instruct",
      "kind": "llm",
      "model": "@cf/meta/llama-3.2-3b-instruct",
      "freeLimits": {
        "neuronsPerDay": 10000,
        "reset": "00:00 UTC"
      },
      "neuronRatesPerMillionTokens": {
        "input": 4625,
        "output": 30475
      },
      "shadowRates": {
        "inputPerMillionTokensMicroUsd": 51000,
        "outputPerMillionTokensMicroUsd": 335000
      },
      "paidUsageReference": "$0.011 per 1,000 neurons beyond the included daily allocation on Workers Paid",
