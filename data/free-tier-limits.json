{
  "version": "3.0.0",
  "lastVerified": "2026-08-21",
  "notes": "ProjectHub uses local deterministic RAG/orchestration work and Cloudflare Workers AI for generative inference. Ollama is retained only as an optional local fallback where configured; it is not the primary dev/production inference provider.",
  "egressOverheadFactor": 1.08,
