# Production environment for ProjectHub/Scout
# Copy to .env. Never commit .env.
#
# ProjectHub/Scout is being developed as the cloud-hosted replacement for
# the existing generative AI chatbot on Bradley's website.
# The current website chatbot uses a Groq-hosted Llama 8B model retiring Aug 16, 2026.
# Production target: cloud-hosted backend with generative inference.
# Development/evaluation model: qwen2.5:1.5b via Ollama (dev/test runtime only).
# Future: cloud generation OR optional browser WebGPU generation.

PORT=3000
HOST=0.0.0.0
KNOWLEDGE_FILE=data/recruiter-knowledge.json
ALLOWED_ORIGINS=https://bradleymatera.dev,https://www.bradleymatera.dev,https://bradleymatera.github.io

# Inference — Ollama URL (containerized: http://inference:11434, local: http://127.0.0.1:11434)
OLLAMA_URL=http://inference:11434
GEN_ENABLED=true
GEN_MODEL=qwen2.5:1.5b
GEN_TIMEOUT_MS=12500
OLLAMA_AGENT_ENABLED=true
OLLAMA_AGENT_MODEL=qwen2.5:1.5b
OLLAMA_AGENT_TIMEOUT_MS=2500
OLLAMA_AGENT_CONTEXT=2048
OLLAMA_AGENT_KEEP_ALIVE=-1

# Tools, retrieval, and persistence
AGENT_ENABLED=true
USE_BM25_RETRIEVAL=true
RATE_LIMIT_MAX=20
STATS_FILE=stats.json
LEARNED_FILE=learned.json
COST_TRACKER=true
COST_FILE=costs.json
