# Production environment for ProjectHub/Scout
# Copy this file to .env on the live GCP VM and fill in the real values.
# Never commit .env to Git.

PORT=3000

KNOWLEDGE_URL=https://raw.githubusercontent.com/BradleyMatera/ProjectHub/master/data/recruiter-knowledge.json

ALLOWED_ORIGINS=https://bradleymatera.dev,https://www.bradleymatera.dev,https://bradleymatera.github.io

PROVIDER_ORDER=cloudflare,gemini,grok
AGENT_ENABLED=true
AGENT_GROQ_ENABLED=false
AGENT_TIMEOUT_MS=6000
OLLAMA_AGENT_ENABLED=true
OLLAMA_AGENT_MODEL=gemma3:270m
OLLAMA_AGENT_TIMEOUT_MS=12000
OLLAMA_AGENT_CONTEXT=1024
OLLAMA_AGENT_KEEP_ALIVE=60s

GEN_TIMEOUT_MS=13000
GEN_MODEL=smollm2:135m
GEN_ENABLED=true
RATE_LIMIT_MAX=20

STATS_FILE=stats.json
LEARNED_FILE=learned.json

# Cost ledger (live free-tier tracker, also shown on the analytics dashboard)
COST_TRACKER=true
COST_FILE=costs.json

# Think Mode (self-improvement)
# These default to the production repo if unset.
THINK_PUSH_ENABLED=true
THINK_REPO_OWNER=BradleyMatera
THINK_REPO_NAME=ProjectHub
THINK_KNOWLEDGE_PATH=data/recruiter-knowledge.json

# Groq is disabled by default. Opt in only with an explicitly selected,
# current model after checking the account's exact free-tier limits.
GROQ_ENABLED=false
GROQ_MODEL=
GROQ_AGENT_MODEL=
GROQ_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
XAI_API_KEY=

# Retrieval pipeline
USE_BM25_RETRIEVAL=true
USE_VECTOR_RETRIEVAL=false
EMBEDDING_MODEL=@cf/baai/bge-small-en-v1.5
SEMANTIC_CACHE_THRESHOLD=0.92
