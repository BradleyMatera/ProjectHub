{
  "name": "projecthub",
  "version": "1.0.0",
  "description": "Free embeddable AI recruiter assistant using local Ollama, conversational memory, and grounded RAG",
  "main": "ProjectHub.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "reset-stats": "node scripts/reset-stats.js",
    "reset-stats:remote": "node scripts/reset-stats.js --remote",
    "test": "node --test test/**/*.test.js",
    "test:ledger": "node --test test/cost-ledger.test.js test/cost-insights.test.js",
    "test:retrieval": "node --test test/bm25.test.js test/query-understanding.test.js test/rrf.test.js",
    "eval-retrieval": "node scripts/eval-retrieval.js",
    "eval:local-api": "node scripts/eval-local-api.js",
    "eval:production-conversations": "python3 test-production-conversations.py"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BradleyMatera/ProjectHub.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/BradleyMatera/ProjectHub/issues"
  },
  "homepage": "https://bradleymatera.github.io/ProjectHub/",
  "devDependencies": {
    "vite": "^8.1.4"
  },
  "dependencies": {
    "@carbon/charts": "^1.22.0",
    "@carbon/styles": "^1.67.0",
    "@carbon/web-components": "^2.18.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0"
  }
}
