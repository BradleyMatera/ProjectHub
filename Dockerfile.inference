# Base image — ollama/ollama:0.7.1
# Supports OLLAMA_CONTEXT_LENGTH env var for context window control.
# Force amd64 platform — the arm64 image runs under QEMU emulation on amd64 hosts
# and is ~10x slower, causing all inference to exceed the 15s deadline.
# Note: Digest pinning with --platform has a Docker builder bug with attestation
# manifests (application/vnd.in-toto+json). Using tag + platform until fixed.
FROM --platform=linux/amd64 ollama/ollama:0.7.1

# Model is pulled at startup via entrypoint script
ENV OLLAMA_HOST=0.0.0.0:11434
ENV OLLAMA_MODEL=qwen2.5:1.5b
ENV OLLAMA_KEEP_ALIVE=-1
ENV OLLAMA_NUM_THREAD=4
ENV OLLAMA_CONTEXT_LENGTH=1536

# Copy the model pull script
COPY docker/inference-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Health check — Ollama /api/tags responds when ready
HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=5 \
  CMD ollama list | grep -q "qwen2.5:1.5b" || exit 1

EXPOSE 11434

ENTRYPOINT ["/entrypoint.sh"]
